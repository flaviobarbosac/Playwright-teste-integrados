{
  "name": "playwright-teste-integrados",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:headed:slow": "playwright test --headed",
    "test:integrado": "playwright test -c playwright.integracao.config.ts",
    "test:integrado:headed": "playwright test -c playwright.integracao.config.ts --headed",
    "test:dev": "playwright test -c playwright.dev.config.ts",
    "test:dev:headed": "playwright test -c playwright.dev.config.ts --headed",
    "auth:save": "playwright codegen https://www.dev.clampfy.com --save-storage=e2e-integrado/.auth/user.json",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
