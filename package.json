{
  "name": "playwright-teste-integrados",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:headed:slow": "playwright test --headed",
    "test:integrado": "playwright test -c playwright.integracao.config.ts",
    "test:integrado:headed": "playwright test -c playwright.integracao.config.ts --headed",
    "test:dev": "node scripts/check-cdp.mjs && playwright test -c playwright.dev.config.ts",
    "test:dev:headed": "node scripts/check-cdp.mjs && playwright test -c playwright.dev.config.ts --headed",
    "chrome:debug": "node scripts/chrome-debug.mjs",
    "auth:save": "node scripts/save-auth.mjs",
    "test:report": "playwright show-report reports/html",
    "test:resumo": "node -e \"const fs=require('fs');const p='reports/ultimo-resumo.md';console.log(fs.existsSync(p)?fs.readFileSync(p,'utf8'):'Nenhum relatório encontrado. Rode os testes primeiro.')\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
