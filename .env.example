# 1) Abra o Chrome pelo atalho "Chrome E2E" (barra de tarefas)
# 2) Faça login em https://www.dev.clampfy.com
# 3) Rode os testes (abre nova aba no mesmo Chrome):
#    npm run test:dev:headed
#
# Opcional — salvar sessão em arquivo:
#    npm run auth:save

E2E_AUTH_MODE=cdp
E2E_CDP_URL=http://127.0.0.1:9222
E2E_BASE_URL=https://www.dev.clampfy.com
E2E_API_BASE_URL=https://api.dev.clampfy.com/api/v1
